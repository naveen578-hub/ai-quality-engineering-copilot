# Copy this file to .env and fill in real values. Never commit a real .env.

# --- LLM ---
# If left unset, the backend runs in "mock" mode and returns deterministic
# synthetic test cases instead of calling OpenAI. Useful for demos/CI without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Database (introduced Phase 2+) ---
POSTGRES_USER=qe_copilot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=qe_copilot
DATABASE_URL=postgresql://qe_copilot:change_me@localhost:5432/qe_copilot

# --- Vector store (introduced Phase 2) ---
CHROMA_PERSIST_DIR=./data/chroma

# --- Embedding mode override (optional) ---
# Auto-selects: llm (if OPENAI_API_KEY set) -> local (real ONNX model, no
# key needed, ~80MB one-time download) -> mock (fully offline fallback).
# Set to "local" or "mock" to force a specific tier regardless of API key.
QE_COPILOT_EMBEDDING_MODE=

# --- Auth (introduced Phase 4) ---
# REQUIRED for any real deployment — the app runs with an insecure default
# signing key otherwise (fine for local demo only; a warning is logged).
QE_COPILOT_JWT_SECRET=
QE_COPILOT_TOKEN_EXPIRE_MINUTES=60
# Seeds one admin account on first startup if no users exist yet. If left
# unset, defaults to admin/changeme123 — fine for a local demo, not for
# anywhere real.
QE_COPILOT_ADMIN_USERNAME=
QE_COPILOT_ADMIN_PASSWORD=

# --- Persistence path overrides (mainly for tests; see backend/tests/conftest.py) ---
QE_COPILOT_DB_PATH=./data/qe_copilot.db

# --- Observability (introduced Phase 4) ---
# No external service needed — usage/cost/latency are tracked in SQLite and
# exposed via GET /api/v1/observability/usage. These are optional overrides
# for the illustrative per-model $/1K-token rates in backend/observability/pricing.py,
# e.g. QE_COPILOT_PRICE_GPT_4O_MINI_INPUT=0.00015
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
